{
  "name": "qrow-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Qrow agent server: one Claude call per send to explain the deterministic check results in plain language. Read-only; never signs or sends.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start:prod": "tsx src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
