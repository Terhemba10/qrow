# Copy to .env (git-ignored) and fill in locally. NEVER commit real values.
# Testnet only: qorechain-diana, EVM chain id 9800. Never use a mainnet-funded account.

# --- Deployer account -------------------------------------------------------
# Either a BIP-39 mnemonic (account m/44'/60'/0'/0/0; its ML-DSA-87 key derives from it)...
QORE_MNEMONIC=
# ...or a private key (0x + 64 hex) together with its PQC recovery code (QRC1-...).
PRIVATE_KEY=
QORE_PQC_RECOVERY_CODE=

QORE_NETWORK=testnet
# Optional: your own node instead of the public (rate-limited) endpoints.
QORE_REST_URL=
QORE_RPC_URL=
QORE_EVM_RPC_URL=https://evm-testnet.qore.host

# Filled in after deploy (used by pq:selftest and the window helper's --escrow scope).
QROW_ESCROW_ADDRESS=
