{
  "name": "qrow-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "QrowEscrow: post-quantum protected escrow on the QoreChain EVM (testnet qorechain-diana).",
  "scripts": {
    "forge-std": "forge install foundry-rs/forge-std --no-git",
    "build": "forge build",
    "test": "forge test -vv",
    "coverage": "forge coverage --report summary",
    "window": "tsx --env-file=.env scripts/window.ts",
    "pq:selftest": "tsx --env-file=.env scripts/pq-selftest.ts",
    "deploy:testnet": "tsx --env-file=.env scripts/deploy.ts",
    "typecheck": "tsc --noEmit",
    "account:new": "tsx scripts/account-new.ts",
    "check:pq-message": "tsx scripts/check/pq-message-compat.ts",
    "pay": "tsx --env-file=.env scripts/pay.ts",
    "deps:sol": "git clone --depth 1 --branch v1.17.0 https://github.com/foundry-rs/forge-std lib/forge-std && git clone --depth 1 --branch v5.6.1 https://github.com/OpenZeppelin/openzeppelin-contracts lib/openzeppelin-contracts",
    "deploy:sprint": "tsx --env-file=.env scripts/deploy-sprint.ts",
    "action": "tsx --env-file=.env scripts/action.ts",
    "seal": "tsx --env-file=.env scripts/seal.ts",
    "deploy:demo": "tsx --env-file=.env scripts/deploy-demo.ts",
    "pq": "tsx --env-file=.env scripts/pq-call.ts",
    "stake": "tsx --env-file=.env scripts/stake.ts",
    "deploy:v2": "tsx --env-file=.env scripts/deploy-v2.ts",
    "appkey": "tsx --env-file=.env scripts/appkey.ts",
    "crossvm-probe": "tsx --env-file=.env scripts/crossvm-probe.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "0.14.0",
    "@qorechain/qoreseal": "^0.1.0",
    "@qorechain/qoresign": "0.2.0",
    "@qorechain/sdk": "0.14.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
