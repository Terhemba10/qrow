# Qrow web app. Copy to .env.local for `npm run dev` (git-ignored). On Vercel set these in
# Project → Settings → Environment Variables. NEVER commit real values. Testnet only.

# ---------------------------------------------------------------- build-time (VITE_*: public, in the bundle)
# The deployed escrow (defaults to the address in src/config/network.ts).
VITE_QROW_ESCROW=
# Fest-sprint contracts (contracts/deployments/testnet.json after `npm run deploy:sprint2`).
VITE_QROW_PREDICT=
VITE_QROW_EDITIONS=
VITE_QROW_PERPS=
# Comma-separated 0x addresses that see the Admin controls (default: the deployer).
VITE_ADMIN_ADDRESSES=
# Optional: IPFS gateway for showing NFT images (default https://gateway.pinata.cloud/ipfs/).
VITE_IPFS_GATEWAY=
# Optional: QoreX dApp deep link once QoreChain documents one, e.g. qorex://browser?url={url}
VITE_QOREX_DAPP_LINK=
# Dev only (npm run dev): a public address for the read-only watch wallet. It can't sign.
VITE_DEV_WATCH_ADDRESS=

# ---------------------------------------------------------------- server-side secrets (never VITE_)
# Create NFT: Pinata JWT (pinata.cloud → API Keys → New key with pinFileToIPFS + pinJSONToIPFS).
PINATA_JWT=
# Trade: a fresh EVM private key that ONLY signs price reports (fund nothing to it), and the perps address.
PRICE_SIGNER_KEY=
QROW_PERPS_ADDRESS=
# AI tab: Claude for chat, Replicate for images and videos.
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=
# Optional model overrides (defaults: black-forest-labs/flux-schnell, wan-video/wan-2.2-t2v-fast).
REPLICATE_IMAGE_MODEL=
REPLICATE_VIDEO_MODEL=
# AI tab: the qor1… testnet address that receives top-ups (a wallet you control; QoreX works).
AI_TREASURY_QOR=
# AI credit balances: Upstash Redis REST (or Vercel KV, which sets KV_REST_API_URL / KV_REST_API_TOKEN).
# Without it, balances are in memory and reset when the function restarts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: extra origins allowed to call /api/ipfs and /api/ai (comma-separated).
QROW_ALLOWED_ORIGINS=
