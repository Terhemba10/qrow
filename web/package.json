    "@qorechain/sdk": "0.14.0",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "^5.59.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "viem": "~2.53.1",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
